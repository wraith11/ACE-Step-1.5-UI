# ACE-Step Music web UI configuration
# Copy to .env and edit as needed.

# UI backend port (Express)
PORT=3001

# ACE-Step REST API server URL
ACESTEP_API_URL=http://localhost:8001

# Where generated audio is stored
AUDIO_DIR=./public/audio

# Frontend URL (Vite dev server).
# Leave FRONTEND_URL unset to inherit the UI_PORT value. To run the frontend
# on a different port (e.g. 3005 when Open WebUI already uses 3000):
#   UI_PORT=3005 ./start.sh
FRONTEND_URL=

# Local session secret
JWT_SECRET=ace-step-music-local-secret