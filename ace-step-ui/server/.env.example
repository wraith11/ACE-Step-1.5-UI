# ACE-Step UI Backend Configuration
# Copy to .env in this folder (server/) or the repo root and edit.

# Server
PORT=3001
NODE_ENV=development

# SQLite database (stored inside server/)
DATABASE_PATH=./data/acestep.db

# ACE-Step REST API server (start this separately, e.g. via start-all-macos.sh)
ACESTEP_API_URL=http://localhost:8001

# Where generated audio is stored (served at /audio)
AUDIO_DIR=./public/audio

# Frontend origin (used for CORS + redirects)
FRONTEND_URL=http://localhost:3000

# JWT secret for local sessions (fine to leave default for a single-user app)
JWT_SECRET=ace-step-ui-local-secret